        "xPos": 0,
        "widget": {
          "title": "Pipeline Phase: Segmentation (Internal)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "Success Rate",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch dataflow_job | { metric 'dataflow.googleapis.com/job/user_counter' | filter (resource.job_name == 'segmentation-pipeline-${environment}' && metric.metric_name == 'segmentation_success') | group_by [], sum(val()) | align rate(60s) | every 60s ; metric 'dataflow.googleapis.com/job/user_counter' | filter (resource.job_name == 'segmentation-pipeline-${environment}' && (metric.metric_name == 'segmentation_success' || metric.metric_name == 'segmentation_error')) | group_by [], sum(val()) | align rate(60s) | every 60s } | ratio"
                }
              },
              {
                "legendTemplate": "Error Rate",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch dataflow_job | { metric 'dataflow.googleapis.com/job/user_counter' | filter (resource.job_name == 'segmentation-pipeline-${environment}' && metric.metric_name == 'segmentation_error') | group_by [], sum(val()) | align rate(60s) | every 60s ; metric 'dataflow.googleapis.com/job/user_counter' | filter (resource.job_name == 'segmentation-pipeline-${environment}' && (metric.metric_name == 'segmentation_success' || metric.metric_name == 'segmentation_error')) | group_by [], sum(val()) | align rate(60s) | every 60s } | ratio"
                }
              },
              {
                "legendTemplate": "Started (Y2)",
                "plotType": "LINE",
                "targetAxis": "Y2",
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch dataflow_job | metric 'dataflow.googleapis.com/job/user_counter' | filter (resource.job_name == 'segmentation-pipeline-${environment}' && metric.metric_name == 'segmentation_start') | group_by [], sum(val()) | align rate(60s) | every 60s"
                }
              }
            ],
            "yAxis": {
              "label": "Rate",
              "scale": "LINEAR"
            },
            "y2Axis": {
              "label": "Started (events/sec)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "height": 4,
