            "timeSeriesQuery": {
              "timeSeriesQueryLanguage": "fetch cloud_run_revision | metric 'logging.googleapis.com/user/pipeline_stage_count' | group_by [], sum(if(metric.stage == 'normalization' && metric.status == 'error', val(), 0)) / sum(if(metric.stage == 'normalization' && metric.status == 'start', val(), 1))"
