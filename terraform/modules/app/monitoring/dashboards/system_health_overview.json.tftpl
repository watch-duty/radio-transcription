{
  "displayName": "System Health Overview (${environment})",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "height": 1,
        "widget": {
          "text": {
            "content": "# \u23f1\ufe0f End-to-End Latency (Audio Capture to Evaluation)\nMeasures total elapsed time from when broadcast audio was received by our ingestion collectors to when evaluation completes.",
            "format": "MARKDOWN",
            "style": {}
          },
          "title": "Section: End-to-End Latency"
        },
        "width": 12,
        "yPos": 0
      },
      {
        "height": 4,
        "widget": {
          "title": "E2E Audio Capture to Evaluation Latency (p50, p95, p99)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/${e2e_latency_metric_name}\" resource.type=\"cloud_run_revision\""
                  }
                }
              },
              {
                "legendTemplate": "p95",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/${e2e_latency_metric_name}\" resource.type=\"cloud_run_revision\""
                  }
                }
              },
              {
                "legendTemplate": "p99",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/${e2e_latency_metric_name}\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "thresholds": [
              {
                "label": "Alert Threshold (5m)",
                "value": 300000,
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "Latency (ms)",
              "scale": "LINEAR"
            }
          }
        },
        "width": 6,
        "yPos": 3,
        "xPos": 0
      },
      {
        "height": 4,
        "widget": {
          "title": "E2E Audio Capture to Evaluation Latency by Feed Type (p95)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "$${metric.labels.feed_type}",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "groupByFields": [
                        "metric.label.feed_type"
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/${e2e_latency_metric_name}\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "thresholds": [
              {
                "label": "Alert Threshold (5m)",
                "value": 300000,
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "Latency (ms)",
              "scale": "LINEAR"
            }
          }
        },
        "width": 6,
        "yPos": 3,
        "xPos": 6
      },
      {
        "height": 1,
        "widget": {
          "text": {
            "content": "# \ud83d\udce5 Ingestion Health (Inputs)\nMetrics for audio acquisition (e.g., Icecast, API polling).",
            "format": "MARKDOWN",
            "style": {}
          },
          "title": "Section: Ingestion Health"
        },
        "width": 12,
        "yPos": 7
      },
      {
        "height": 4,
        "widget": {
          "title": "Ingested Audio Chunks (Rate)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.source_type"
                      ],
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/ingestion_chunk_ingested_${environment}\""
                  }
                }
              }
            ]
          }
        },
        "width": 6,
        "yPos": 8,
        "xPos": 0
      },
      {
        "height": 4,
        "widget": {
          "title": "Audio Download Failures (Rate)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.source_type"
                      ],
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/ingestion_call_download_failed_${environment}\""
                  }
                }
              }
            ]
          }
        },
        "width": 6,
        "xPos": 6,
        "yPos": 8
      },
      {
        "height": 4,
        "widget": {
          "title": "Active Feed Leases (Total & p99/worker)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "p99 / worker",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch gce_instance | metric 'logging.googleapis.com/user/ingestion_active_feed_count_${environment}' | align delta(60s) | group_by [], percentile(val(), 99)"
                }
              },
              {
                "legendTemplate": "Total Active Leases",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch gce_instance | metric 'logging.googleapis.com/user/ingestion_active_feed_count_${environment}' | align delta(60s) | group_by [], sum(val())"
                }
              }
            ]
          }
        },
        "width": 6,
        "yPos": 12,
        "xPos": 0
      },
      {
        "height": 4,
        "widget": {
          "title": "Ingestion MIG CPU Utilization (p50, p95, p99)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\" metadata.system_labels.name=starts_with(\"ingestion-collector-${environment}\")"
                  }
                },
                "legendTemplate": "p50"
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\" metadata.system_labels.name=starts_with(\"ingestion-collector-${environment}\")"
                  }
                },
                "legendTemplate": "p95"
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\" metadata.system_labels.name=starts_with(\"ingestion-collector-${environment}\")"
                  }
                },
                "legendTemplate": "p99"
              }
            ],
            "yAxis": {
              "label": "CPU %",
              "scale": "LINEAR"
            }
          }
        },
        "width": 6,
        "xPos": 6,
        "yPos": 12
      },
      {
        "height": 4,
        "widget": {
          "title": "Ingestion MIG Disk I/O (Fleet Total)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"compute.googleapis.com/instance/disk/read_bytes_count\" resource.type=\"gce_instance\" metadata.system_labels.name=starts_with(\"ingestion-collector-${environment}\")"
                  }
                },
                "legendTemplate": "Read"
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"compute.googleapis.com/instance/disk/write_bytes_count\" resource.type=\"gce_instance\" metadata.system_labels.name=starts_with(\"ingestion-collector-${environment}\")"
                  }
                },
                "legendTemplate": "Write"
              }
            ]
          }
        },
        "width": 6,
        "yPos": 16,
        "xPos": 0
      },
      {
        "height": 4,
        "widget": {
          "title": "Ingestion MIG Disk I/O (p99 Peak Node)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"compute.googleapis.com/instance/disk/read_bytes_count\" resource.type=\"gce_instance\" metadata.system_labels.name=starts_with(\"ingestion-collector-${environment}\")"
                  }
                },
                "legendTemplate": "Read"
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"compute.googleapis.com/instance/disk/write_bytes_count\" resource.type=\"gce_instance\" metadata.system_labels.name=starts_with(\"ingestion-collector-${environment}\")"
                  }
                },
                "legendTemplate": "Write"
              }
            ]
          }
        },
        "width": 6,
        "yPos": 16,
        "xPos": 6
      },
      {
        "height": 1,
        "widget": {
          "text": {
            "content": "# \u2699\ufe0f Pipeline Phases\nMetrics for asynchronous background workers (Transcription, Evaluation, Dataflow).",
            "format": "MARKDOWN",
            "style": {}
          },
          "title": "Section: Pipeline Phases"
        },
        "width": 12,
        "yPos": 20
      },
      {
        "height": 4,
        "width": 12,
        "yPos": 21,
        "xPos": 0,
        "widget": {
          "title": "Pipeline Stage Throughput (Rate)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "1. Ingested Audio (continuous-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"continuous-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "2. Segmented Chunks - Claims (segmented-audio-claims)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"segmented-audio-claims-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "2b. Segmented Chunks - Bypass (segmented-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"segmented-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "3. Normalized Audio (normalized-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"normalized-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "4. Transcribed Audio (transcribed-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"transcribed-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "5. Evaluated Audio (evaluated-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"evaluated-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "6. Triggered Notifications (sent-messages)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/sent_message_count\" resource.type=\"pubsub_subscription\" resource.labels.subscription_id=\"alert-notification-subscription-${environment}\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Throughput (messages/sec)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "height": 4,
        "width": 12,
        "yPos": 25,
        "xPos": 0,
        "widget": {
          "title": "Pipeline Stage Throughput (Total per Minute)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "1. Ingested Audio (continuous-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"continuous-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "2. Segmented Chunks - Claims (segmented-audio-claims)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"segmented-audio-claims-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "2b. Segmented Chunks - Bypass (segmented-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"segmented-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "3. Normalized Audio (normalized-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"normalized-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "4. Transcribed Audio (transcribed-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"transcribed-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "5. Evaluated Audio (evaluated-audio)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/topic/send_request_count\" resource.type=\"pubsub_topic\" resource.labels.topic_id=\"evaluated-audio-${environment}\""
                  }
                }
              },
              {
                "legendTemplate": "6. Triggered Notifications (sent-messages)",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/sent_message_count\" resource.type=\"pubsub_subscription\" resource.labels.subscription_id=\"alert-notification-subscription-${environment}\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Total Messages / Minute",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "height": 4,
        "widget": {
          "title": "Pub/Sub Backlogs (Unacked Messages)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.label.subscription_id"
                      ],
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" resource.type=\"pubsub_subscription\" resource.labels.subscription_id=one_of(\"continuous-audio-sub-${environment}\", \"normalization-subscription-${environment}\", \"normalization-segmented-bypass-subscription-${environment}\", \"transcription-subscription-${environment}\", \"evaluation-subscription-${environment}\", \"alert-notification-subscription-${environment}\")"
                  }
                }
              }
            ]
          }
        },
        "width": 6,
        "yPos": 29,
        "xPos": 0
      },
      {
        "height": 4,
        "widget": {
          "title": "Pub/Sub Staleness (Oldest Unacked)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.label.subscription_id"
                      ],
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/oldest_unacked_message_age\" resource.type=\"pubsub_subscription\" resource.labels.subscription_id=one_of(\"continuous-audio-sub-${environment}\", \"normalization-subscription-${environment}\", \"normalization-segmented-bypass-subscription-${environment}\", \"transcription-subscription-${environment}\", \"evaluation-subscription-${environment}\", \"alert-notification-subscription-${environment}\")"
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Seconds",
              "scale": "LINEAR"
            }
          }
        },
        "width": 6,
        "xPos": 6,
        "yPos": 29
      },
      {
        "height": 4,
        "widget": {
          "title": "Cloud Run Pipeline Workers CPU (p50, p95, p99)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "groupByFields": [
                        "resource.label.service_name"
                      ],
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" resource.type=\"cloud_run_revision\" resource.labels.service_name=one_of(\"evaluation-pipeline-${environment}\", \"transcription-service-${environment}\", \"notification-pipeline-${environment}\", \"echo-audio-ingestion-${environment}\", \"normalization-service-${environment}\")"
                  }
                },
                "legendTemplate": "p50 - $${resource.labels.service_name}"
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.label.service_name"
                      ],
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" resource.type=\"cloud_run_revision\" resource.labels.service_name=one_of(\"evaluation-pipeline-${environment}\", \"transcription-service-${environment}\", \"notification-pipeline-${environment}\", \"echo-audio-ingestion-${environment}\", \"normalization-service-${environment}\")"
                  }
                },
                "legendTemplate": "p95 - $${resource.labels.service_name}"
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
