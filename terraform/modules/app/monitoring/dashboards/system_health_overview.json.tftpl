        "height": 2,
        "width": 2,
        "yPos": 1,
        "xPos": 0,
        "widget": {
          "title": "Segmentation Error Rate (Errors / Processed)",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesQueryLanguage": "fetch dataflow_job | { metric 'dataflow.googleapis.com/job/user_counter' | filter (resource.job_name == 'segmentation-pipeline-${environment}' && metric.metric_name == 'segmentation_error') | group_by [], sum(val()) | align rate(300s) | every 300s ; metric 'dataflow.googleapis.com/job/user_counter' | filter (resource.job_name == 'segmentation-pipeline-${environment}' && (metric.metric_name == 'segmentation_success' || metric.metric_name == 'segmentation_error')) | group_by [], sum(val()) | align rate(300s) | every 300s } | ratio"
            }
          }
