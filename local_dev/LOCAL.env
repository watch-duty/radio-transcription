PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
# TODO consolidate with GOOGLE_CLOUD_PROJECT
GOOGLE_CLOUD_PROJECT=local-project
PROJECT_ID=local-project
NORMALIZER_SERVICE_HOST=normalization:8083
TRANSCRIPTION_SERVICE_HOST=transcription:8084
RULES_EVALUATION_SERVICE_HOST=rules-evaluation:8080
NOTIFICATION_SERVICE_HOST=notification:8081
MOCK_SERVER_HOST=mock-server:8082
RULES_API_HOST=rules-management:8086
TRANSCRIPTS_API_HOST=transcripts-api:8087
FEEDS_API_HOST=feeds-api:8089
AUDIO_SEGMENTS_API_HOST=audio-segments-api:8091
FRONTEND_API_HOST=frontend-api:8080
CONTINUOUS_TOPIC=projects/local-project/topics/continuous-audio
SEGMENTED_TOPIC=projects/local-project/topics/segmented-audio
SEGMENTED_PUBSUB_TOPIC_PATH=projects/local-project/topics/segmented-audio
TRANSCRIPTION_TOPIC=projects/local-project/topics/transcription-text-topic
TRANSCRIPTION_DLQ_TOPIC=projects/local-project/topics/transcription-text-topic-dlq
RULES_EVALUATION_RESULTS_TOPIC=projects/local-project/topics/rules-evaluation-results-topic

# Transcription config
# Can be changed to "local_whisper" to run with local Whisper API service
TRANSCRIBER_TYPE=mock
LOCAL_ASR_API_URL=http://local-whisper:8095/transcribe
# Uncomment the line below to build/run the local-whisper container in your dev environment:
# COMPOSE_PROFILES=local-whisper
CONTINUOUS_AUDIO_SUBSCRIPTION=continuous-audio-sub
SEGMENTED_AUDIO_SUBSCRIPTION=segmented-audio-sub

# TODO consolidate this variable with the MOCK_SERVER_HOST variable
NOTIFICATION_ENDPOINT=http://mock-server:8082/post
NOTIFICATION_ENDPOINT_API_KEY=mock
REDIS_HOST=redis
REDIS_PORT=6379
APP_URL=http://localhost:5173
# TODO consolidate this with RULES_API_HOST
RULES_API_URL=http://rules-management:8086
# E2E tests create rules dynamically; keep local rule evaluation uncached.
RULES_CACHE_TTL_SECONDS=0
TRANSCRIPTS_API_URL=http://transcripts-api:8087
FEEDS_API_URL=http://feeds-api:8089
FEEDS_STORE_API_URL=http://feeds-api:8089
AUDIO_SEGMENTS_API_URL=http://audio-segments-api:8091

# Storage settings
ALLOYDB_HOST=postgres
ALLOYDB_PORT=5432
ALLOYDB_USER=postgres
ALLOYDB_DB=postgres
ALLOYDB_PASSWORD=postgres
ALLOYDB_POOL_MIN_SIZE=2
ALLOYDB_POOL_MAX_SIZE=5
ALLOWED_ORIGIN=http://localhost:5173
AUTH_BACKEND=none
# GCS setup
STORAGE_EMULATOR_HOST=http://gcs-emulator:4443
AUDIO_STAGING_BUCKET=test-staging-bucket
AUDIO_CANONICAL_BUCKET=test-canonical-bucket
ECHO_RECORDINGS_BUCKET=echo-recordings-test

# Mock Icecast setup
BCFY_FEEDS_URL_BASE=http://mock-audio-server:8090/
BROADCASTIFY_USERNAME=mock
BROADCASTIFY_PASSWORD=mock
BCFY_CALLS_URL_BASE=http://mock-audio-server:8090/calls
MOCK_JWT_TOKEN=mock_token

# Fire Notifications Setup
FIRE_NOTIFICATIONS_S3_BASE=http://mock-audio-server:8090/mock-s3
FIRE_NOTIFICATIONS_URL_BASE=http://mock-audio-server:8090/api/audio/
FIRE_NOTIFICATIONS_USER=mock-user
FIRE_NOTIFICATIONS_PASSWORD=mock-password



