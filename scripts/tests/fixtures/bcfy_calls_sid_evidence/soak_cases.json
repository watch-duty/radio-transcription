{
  "reducer": "soak.jq",
  "cases": [
    {
      "name": "cadence_90_ratio_boundaries_and_last_pos_equality",
      "scenario": "all_ratio_boundaries",
      "poll_count": 2700,
      "expect": "pass",
      "expected_polls_per_minute": 90,
      "expected_attempt_ratio": 1.25,
      "expected_row_ratio": 1.25
    },
    {
      "name": "cadence_120_inclusive",
      "scenario": "baseline",
      "poll_count": 3600,
      "expect": "pass",
      "expected_polls_per_minute": 120
    },
    {
      "name": "cadence_immediately_below_90",
      "scenario": "baseline",
      "poll_count": 2699,
      "expect": "reject",
      "error": "logical poll cadence is outside"
    },
    {
      "name": "cadence_immediately_above_120",
      "scenario": "baseline",
      "poll_count": 3601,
      "expect": "reject",
      "error": "logical poll cadence is outside"
    },
    {
      "name": "attempt_ratio_immediately_above_1_25",
      "scenario": "attempt_ratio_above",
      "poll_count": 2700,
      "expect": "reject",
      "error": "HTTP attempts exceed 1.25"
    },
    {
      "name": "row_ratio_immediately_above_1_25",
