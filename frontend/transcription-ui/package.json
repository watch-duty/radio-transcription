{
  "name": "transcription-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "local": "vite --mode local-dev",
    "dev": "vite --mode dev",
    "prod": "vite --mode production",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:prod": "tsc -b && vite build --mode production",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "format:fix": "prettier --ignore-path ../../.prettierignore --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.2",
    "@react-oauth/google": "^0.13.4",
    "@tanstack/react-query": "^5.99.0",
    "@toolpad/core": "^0.16.0",
    "@transcription/common": "link:../common",
    "@wavesurfer/react": "^1.0.12",
    "date-fns": "^4.1.0",
    "howler": "^2.2.4",
    "jose": "^6.2.3",
    "material-symbols": "^0.44.4",
    "pluralize": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.15.0",
    "react-virtuoso": "^4.18.5",
    "relative-time-format": "^1.1.12",
    "swagger-ui-react": "^5.32.3",
    "wavesurfer.js": "^7.12.6"
  },
  "devDependencies": {
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.14.1",
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.10.1",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/ui": "4.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
